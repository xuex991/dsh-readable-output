{
  "name": "dsh-readable-output",
  "version": "0.3.0",
  "description": "A portable DeepSeek Harness plugin that adds a progressive-disclosure output contract and a deterministic checker.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./audit": "./lib/audit.js",
    "./contract": "./lib/contract.js",
    "./cli": "./lib/cli.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "readable-output-audit": "./lib/cli.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test",
    "check": "node lib/cli.js"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "output"
  ],
  "author": "xue1991 (https://github.com/xuex991)",
  "homepage": "https://github.com/xuex991/dsh-readable-output#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuex991/dsh-readable-output.git"
  },
  "bugs": {
    "url": "https://github.com/xuex991/dsh-readable-output/issues"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.1.0-rc.6"
  }
}
